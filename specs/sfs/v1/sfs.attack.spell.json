{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.attack.spell.json",
  "title": "sfs.attack.spell",
  "description": "Resolve a spell attack roll (melee or ranged). Uses caster's spellcasting ability modifier.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["RollMade", "AttackResolved", "EffectPushed"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["attacker", "defender", "spell_id"],
      "additionalProperties": false,
      "properties": {
        "attacker": { "$ref": "_common.json#/$defs/EntityId" },
        "defender": { "$ref": "_common.json#/$defs/EntityId" },
        "spell_id": { "$ref": "_common.json#/$defs/SpellId" },
        "slot_level": { "type": "integer", "minimum": 0 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hit", "crit", "roll"],
      "properties": {
        "roll": { "$ref": "_common.json#/$defs/RollResult" },
        "hit": { "type": "boolean" },
        "crit": { "type": "boolean" },
        "damage": { "$ref": "_common.json#/$defs/DamageInstance" }
      }
    }
  }
}
