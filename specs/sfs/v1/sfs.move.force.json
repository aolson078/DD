{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.move.force.json",
  "title": "sfs.move.force",
  "description": "Forced movement (push/pull). Ignores reactions and does not cost the entity's movement resource.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["ComponentSet"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["entity", "to"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "_common.json#/$defs/EntityId" },
        "to": { "$ref": "_common.json#/$defs/Position" },
        "direction": { "$ref": "_common.json#/$defs/Direction" },
        "distance": { "type": "integer", "minimum": 0 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moved"],
      "properties": {
        "moved": { "type": "boolean" },
        "final_position": { "$ref": "_common.json#/$defs/Position" }
      }
    }
  }
}
