{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.xp.award.json",
  "title": "sfs.xp.award",
  "description": "Award XP to entities. Does NOT auto-level (Invariant PR1). See specs/08 Section 1.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["ResourceChanged"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["recipients", "amount", "source", "reason"],
      "additionalProperties": false,
      "properties": {
        "recipients": { "type": "array", "items": { "$ref": "_common.json#/$defs/EntityId" } },
        "amount": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "enum": ["Encounter", "Milestone", "Driver", "PackDefined"] },
        "reason": { "type": "string" },
        "source_id": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awarded"],
      "properties": {
        "awarded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity", "previous_xp", "new_xp"],
            "properties": {
              "entity": { "$ref": "_common.json#/$defs/EntityId" },
              "previous_xp": { "type": "integer", "minimum": 0 },
              "new_xp": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
