{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.roll.initiative.json",
  "title": "sfs.roll.initiative",
  "description": "Initiative roll for an entity. Typically d20 + DEX modifier + feature bonuses. Used by initialize_combat in specs/07.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["RollMade"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["entity"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "_common.json#/$defs/EntityId" }
      }
    },
    "output": { "$ref": "_common.json#/$defs/RollResult" }
  }
}
