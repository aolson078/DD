{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.effect.remove_persistent.json",
  "title": "sfs.effect.remove_persistent",
  "description": "Remove persistent effects matching a filter from a target.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["PersistentEffectRemoved"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["target", "filter"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "_common.json#/$defs/EntityId" },
        "filter": { "$ref": "_common.json#/$defs/JsonFilter" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removed_ids"],
      "properties": {
        "removed_ids": { "type": "array", "items": { "$ref": "_common.json#/$defs/PersistentEffectInstanceId" } }
      }
    }
  }
}
