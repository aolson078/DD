{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.resource.grant.json",
  "title": "sfs.resource.grant",
  "description": "Increase a resource up to its maximum. Overshoot is clamped unless BoundAbove tag allows it.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["ResourceChanged"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["entity", "resource", "amount"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "_common.json#/$defs/EntityId" },
        "resource": { "$ref": "_common.json#/$defs/ResourceId" },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "current", "maximum"],
      "properties": {
        "previous": { "type": "integer" },
        "current": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    }
  }
}
