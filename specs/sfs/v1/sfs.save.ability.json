{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-sim.spec/schemas/sfs/v1/sfs.save.ability.json",
  "title": "sfs.save.ability",
  "description": "Saving throw against a DC. A save is a check with purpose=Save, no partial thresholds, no crit rule. See specs/05 Section 5.",
  "x-sfs-since": "1.0.0",
  "x-sfs-purity": "Stateful",
  "x-sfs-effects": ["RollMade", "SaveResolved"],
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["target", "save_id", "dc"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "_common.json#/$defs/EntityId" },
        "save_id": { "$ref": "_common.json#/$defs/SaveId" },
        "dc": { "type": "integer" },
        "source": { "$ref": "_common.json#/$defs/EntityId" },
        "advantage_override": { "$ref": "_common.json#/$defs/RollMode" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roll", "total", "dc", "success"],
      "properties": {
        "roll": { "$ref": "_common.json#/$defs/RollResult" },
        "total": { "type": "integer" },
        "dc": { "type": "integer" },
        "success": { "type": "boolean" }
      }
    }
  }
}
